// ==UserScript==
// @name         Traduction Machines Atelier
// @namespace    atelier
// @version      2.0
// @description  Affichage simplifié machines
// @match        http://*
// @match        https://*
// @grant        none
// @run-at       document-end
// ==/UserScript==

(function () {

    'use strict';

    // =========================
    // CORRESPONDANCES
    // =========================

    const traductions = {};

    ['D', 'G'].forEach(lettre => {

        for (let i = 1; i <= 9; i++) {

            traductions[`CUA${i}${lettre}`] = `1/${i}${lettre}`;
        }
    });

    // =========================
    // STYLE
    // =========================

    const style = document.createElement('style');

    style.textContent = `
        .machine-alias {
            color: #2196F3;
            font-weight: bold;
            margin-left: 4px;
        }
    `;

    document.head.appendChild(style);

    // =========================
    // TRAITEMENT
    // =========================

    function traiterNode(node) {

        // Ignore certains éléments
        if (
            !node ||
            !node.parentNode ||
            ['SCRIPT', 'STYLE', 'TEXTAREA', 'INPUT'].includes(node.parentNode.tagName)
        ) {
            return;
        }

        // Evite retraitement
        if (node.parentNode.classList &&
            node.parentNode.classList.contains('machine-processed')) {
            return;
        }

        // Noeud texte uniquement
        if (node.nodeType === Node.TEXT_NODE) {

            let texte = node.nodeValue;
            let trouve = false;

            for (const code in traductions) {

                if (texte.includes(code)) {

                    trouve = true;

                    texte = texte.replaceAll(
                        code,
                        `${code}<span class="machine-alias">(${traductions[code]})</span>`
                    );
                }
            }

            if (trouve) {

                const span = document.createElement('span');

                span.className = 'machine-processed';

                span.innerHTML = texte;

                node.parentNode.replaceChild(span, node);
            }
        }

        else {

            node.childNodes.forEach(traiterNode);
        }
    }

    // =========================
    // LANCEMENT
    // =========================

    traiterNode(document.body);

    // =========================
    // SURVEILLANCE TEMPS REEL
    // =========================

    const observer = new MutationObserver((mutations) => {

        mutations.forEach((mutation) => {

            mutation.addedNodes.forEach((node) => {

                traiterNode(node);
            });
        });
    });

    observer.observe(document.body, {
        childList: true,
        subtree: true
    });

})();
