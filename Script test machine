// ==UserScript==
// @name         Traduction Machines Atelier
// @namespace    usine
// @version      1.0
// @description  Affichage simplifié des machines
// @match        http://*
// @match        https://*
// @grant        none
// ==/UserScript==

(function () {
    'use strict';

    // =========================
    // TABLE DE CORRESPONDANCE
    // =========================

    const traductions = {};

    // Génération automatique :
    // CUA1D -> 1/1D
    // CUA2D -> 1/2D
    // ...
    // CUA9G -> 1/9G

    const lettres = ['D', 'G'];

    lettres.forEach(lettre => {

        for (let i = 1; i <= 9; i++) {

            const codeOriginal = `CUA${i}${lettre}`;
            const codeOperateur = `1/${i}${lettre}`;

            traductions[codeOriginal] = codeOperateur;
        }
    });

    // =========================
    // STYLE
    // =========================

    const style = document.createElement('style');

    style.innerHTML = `
        .machine-traduction {
            color: #2196f3;
            font-weight: bold;
            margin-left: 4px;
        }
    `;

    document.head.appendChild(style);

    // =========================
    // REMPLACEMENT TEXTE
    // =========================

    function remplacerTexte(node) {

        // Ignore certains éléments
        if (
            node.parentNode &&
            ['SCRIPT', 'STYLE', 'TEXTAREA', 'INPUT'].includes(node.parentNode.tagName)
        ) {
            return;
        }

        // Noeud texte uniquement
        if (node.nodeType === Node.TEXT_NODE) {

            let texte = node.nodeValue;

            let remplacementEffectue = false;

            for (const code in traductions) {

                if (texte.includes(code)) {

                    remplacementEffectue = true;

                    texte = texte.replaceAll(
                        code,
                        `${code}|||${traductions[code]}`
                    );
                }
            }

            if (remplacementEffectue) {

                const span = document.createElement('span');

                const morceaux = texte.split('|||');

                // Reconstruction HTML propre
                let html = morceaux[0];

                for (let i = 1; i < morceaux.length; i++) {

                    const traduction = morceaux[i];

                    html += `
                        <span class="machine-traduction">
                            (${traduction})
                        </span>
                    `;
                }

                span.innerHTML = html;

                node.parentNode.replaceChild(span, node);
            }
        }

        // Parcours récursif
        else {

            node.childNodes.forEach(remplacerTexte);
        }
    }

    // =========================
    // LANCEMENT INITIAL
    // =========================

    remplacerTexte(document.body);

    // =========================
    // SURVEILLANCE TEMPS RÉEL
    // =========================

    const observer = new MutationObserver((mutations) => {

        mutations.forEach((mutation) => {

            mutation.addedNodes.forEach((node) => {

                remplacerTexte(node);
            });
        });
    });

    observer.observe(document.body, {
        childList: true,
        subtree: true
    });

})();
